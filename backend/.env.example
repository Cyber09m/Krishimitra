# ---- MongoDB Atlas ----
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/krishimitra?retryWrites=true&w=majority
MONGO_DB_NAME=krishimitra

# ---- Auth ----
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MIN=60

# ---- Gemini (Google AI Studio) ----
# One key powers both the chatbot AND disease detection (image understanding) —
# no separate computer-vision account or model training needed.
# Get your key free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key
# "gemini-flash-latest" is an official alias that always points to the
# current Flash model (Google gives 2 weeks' notice before swapping it) —
# safe default, no need to change this.
GEMINI_MODEL=gemini-flash-latest

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

FLASK_ENV=development
